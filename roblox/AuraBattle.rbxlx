	{ id = "mirageshard", en = "Mirage Shard", ru = "Осколок миража", tier = "uncommon", price = 100000000, colors = { Color3.fromRGB(241, 228, 255), Color3.fromRGB(183, 125, 255), Color3.fromRGB(34, 230, 255) }, image = "" },
