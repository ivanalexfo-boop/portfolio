	{ id = "blizzard", en = "Blizzard", ru = "Метель", tier = "rare", price = 15000, colors = { Color3.fromRGB(255, 197, 61), Color3.fromRGB(62, 240, 143), Color3.fromRGB(255, 61, 203), Color3.fromRGB(34, 230, 255) }, image = "" },
