	{ id = "eclipse", en = "Eclipse", ru = "Затмение", tier = "anomaly", price = 1500000000000, colors = { Color3.fromRGB(255, 197, 61), Color3.fromRGB(62, 240, 143), Color3.fromRGB(255, 61, 203), Color3.fromRGB(34, 230, 255) }, image = "" },
